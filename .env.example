# Copy to .env and fill in from the Shopify app's Settings -> Credentials page.
# Never commit .env.

SHOPIFY_STORE=n4k6ze-uf.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Comma-separated scopes requested during install.
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory,read_locations,read_content,read_price_rules,read_discounts,read_fulfillments,read_shipping

# Must exactly match an entry in the app's "Allowed redirection URL(s)".
SHOPIFY_REDIRECT_URI=http://localhost:3456/callback

# Admin API version.
SHOPIFY_API_VERSION=2025-07

# Set after running `npm run auth`, or leave unset to use .shopify-token.json.
# SHOPIFY_ACCESS_TOKEN=shpua_...
