# Copy to .env and fill in from the Shopify app's Settings -> Credentials page.
# Never commit .env.

SHOPIFY_STORE=n4k6ze-uf.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Comma-separated scopes requested during install.
# Add write_products if you want to create listings (then re-run `npm run auth`).
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_inventory,read_locations,read_content,read_price_rules,read_discounts,read_fulfillments,read_shipping

# Must exactly match an entry in the app's "Allowed redirection URL(s)".
SHOPIFY_REDIRECT_URI=http://localhost:3456/callback

# Admin API version.
SHOPIFY_API_VERSION=2025-07

# Set after running `npm run auth`, or leave unset to use .shopify-token.json.
# SHOPIFY_ACCESS_TOKEN=shpua_...

# Allow creating/updating products. Off by default.
SHOPIFY_ALLOW_WRITES=false

# Allow creating products already published (ACTIVE) instead of DRAFT.
SHOPIFY_ALLOW_PUBLISH=true

# Status for imported products: ACTIVE (live immediately) or DRAFT (reviewed first).
SHOPIFY_PRODUCT_STATUS=ACTIVE

# Theme to write imported product templates into (name as shown in Shopify).
# Leave empty to use the published (live) theme.
SHOPIFY_THEME=
