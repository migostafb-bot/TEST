# Copy to .env and fill in. Never commit the real .env.
# Store handle from your admin URL (admin.shopify.com/store/<handle>/)
SHOPIFY_STORE=city-pharma-2
# Shopify admin > Settings > Apps and sales channels > Develop apps >
# <your app> > API credentials > Admin API access token
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional; defaults to the version pinned in shopify/client.py
SHOPIFY_API_VERSION=2025-10
